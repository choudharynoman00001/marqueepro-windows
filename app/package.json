{
  "name": "marqueepro",
  "version": "0.1.0",
  "description": "MarqueePro - marquee / shadi hall management (multi-tenant, web + Windows wrapper)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:api": "tsc -p .",
    "build:web": "npm ci --prefix apps/web && npm run build --prefix apps/web",
    "start": "node dist/src/main.js",
    "test": "node --test --test-concurrency=1 dist/test/*.test.js",
    "pretest": "tsc -p .",
    "dev:pg": "node scripts/devpg.mjs",
    "local": "node scripts/local.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "bidi-js": "1.1.0",
    "cookie-parser": "^1.4.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "typescript": "^7.0.2",
    "smtp-server": "^3.21.1"
  }
}