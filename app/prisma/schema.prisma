generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attendance {
  id           BigInt    @id @default(autoincrement())
  tenant_id    BigInt
  employee_id  BigInt
  day          String
  status       String
  overtime_min BigInt    @default(0)
  employees    employees @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employee_id, day])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id            BigInt  @id @default(autoincrement())
  tenant_id     BigInt?
  actor_user_id BigInt?
  action        String
  entity_type   String?
  entity_id     BigInt?
  detail        String?
  created_at    String

  @@index([tenant_id, id], map: "ix_audit")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model booking_menu {
  id           BigInt     @id @default(autoincrement())
  tenant_id    BigInt
  booking_id   BigInt
  menu_item_id BigInt
  note         String?
  bookings     bookings   @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menu_items   menu_items @relation(fields: [menu_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([booking_id, menu_item_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model booking_services {
  id          BigInt   @id @default(autoincrement())
  tenant_id   BigInt
  booking_id  BigInt
  description String
  qty_milli   BigInt   @default(1000)
  unit_minor  BigInt   @default(0)
  created_at  String
  bookings    bookings @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model booking_status_history {
  id         BigInt   @id @default(autoincrement())
  tenant_id  BigInt
  booking_id BigInt
  old_status String?
  new_status String
  note       String?
  changed_by BigInt?
  created_at String
  bookings   bookings @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bookings {
  id                     BigInt                   @id @default(autoincrement())
  tenant_id              BigInt
  code                   String
  branch_id              BigInt
  customer_id            BigInt
  venue_id               BigInt
  status                 String                   @default("inquiry")
  event_type             String
  event_date             String
  starts_at              String
  ends_at                String
  setup_min              BigInt                   @default(0)
  cleanup_min            BigInt                   @default(0)
  block_start            DateTime                 @db.Timestamp(6)
  block_end              DateTime                 @db.Timestamp(6)
  guests                 BigInt                   @default(0)
  per_head_minor         BigInt                   @default(0)
  rent_minor             BigInt                   @default(0)
  package_id             BigInt?
  requirements           String?
  checklist              String?
  cancel_reason          String?
  actual_guests          BigInt?
  created_by             BigInt?
  created_at             String
  updated_at             String
  booking_menu           booking_menu[]
  booking_services       booking_services[]
  booking_status_history booking_status_history[]
  branches               branches                 @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers              customers                @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants                tenants                  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venues                 venues                   @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event_tasks            event_tasks[]
  expenses               expenses[]
  food_records           food_records[]
  invoices               invoices[]
  payments               payments[]
  stock_movements        stock_movements[]
  vendor_bills           vendor_bills[]

  @@unique([tenant_id, code])
  @@index([tenant_id, event_date], map: "ix_book_date")
  @@index([tenant_id, venue_id, block_start], map: "ix_book_venue")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branches {
  id         BigInt     @id @default(autoincrement())
  tenant_id  BigInt
  name       String
  address    String?
  active     BigInt     @default(1)
  created_at String
  bookings   bookings[]
  tenants    tenants    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venues     venues[]
}

